# Copy to .env (or run `npm run keys`, which generates the keys for you). Never commit .env.
NETWORK=localhost
WITNESS_PRIVATE_KEY=
GATEWAY_PRIVATE_KEY=
AUDITOR_KEY=
LOCAL_RPC_URL=http://127.0.0.1:8545
# Sepolia: throwaway wallets only
SEPOLIA_RPC_URL=
ADMIN_PRIVATE_KEY=
# Witness endpoint: local emulator, or https://<function-app>.azurewebsites.net/api
WITNESS_URL=http://127.0.0.1:7071/api
GATEWAY_URL=http://127.0.0.1:3001
